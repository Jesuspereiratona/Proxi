# ---- Servidor ----
NODE_ENV=development
PORT=3000
WEB_URL=http://localhost:5173

# ---- Base de datos ----
# En un proveedor administrado (Render, Fly, Railway) la base llega como UNA sola URL. Si
# DATABASE_URL está presente, gana sobre las cinco DB_* de abajo y esas dejan de ser obligatorias.
# DATABASE_URL=postgres://usuario:clave@host:5432/base

# SameSite de la cookie de sesión. 'strict' (el default) solo sirve si la API y la web comparten
# dominio registrable (proxi.cl y api.proxi.cl). Si quedan en sitios distintos —por ejemplo dos
# subdominios de onrender.com, que está en la Public Suffix List— hay que poner 'none' o el
# navegador nunca manda la cookie y la sesión se pierde al recargar. 'none' exige NODE_ENV=production.
# COOKIE_SAMESITE=strict

DB_HOST=localhost
DB_PORT=5433
DB_NAME=proxi_dev
DB_USER=proxi
DB_PASSWORD=cambiame_en_local

# ---- Autenticacion ----
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
BCRYPT_ROUNDS=12

# ---- Datos personales ----
# Clave simetrica de pgcrypto para cifrar el RUT de estudiantes. Generar igual que los secretos JWT.
RUT_CIFRADO_KEY=

# ---- Tareas nocturnas ----
# Secreto del disparador externo (.github/workflows/tareas-nocturnas.yml). En el plan gratuito el
# proceso se duerme y el cron interno no corre; este token deja que GitHub Actions las dispare.
# Sin valor, la ruta POST /tareas/ejecucion responde 404 y solo queda el cron interno.
# Generar con: openssl rand -base64 32
TAREAS_TOKEN=

# ---- Archivos ----
# Los CV se guardan en la base (archivos.contenido), no en disco: el disco de un contenedor es
# efimero. UPLOAD_DIR solo lo usa el script de migracion de una vez `npm run migrar-cv -w apps/api`.
UPLOAD_DIR=./almacenamiento/cv
UPLOAD_MAX_BYTES=5242880

# ---- Correo (verificacion y avisos) ----
# OBLIGATORIO en produccion: la API no arranca sin SMTP_HOST ni MAIL_FROM. Sin ellos el correo de
# verificacion se manda a una casilla falsa de desarrollo y nadie puede activar su cuenta.
# En desarrollo se puede dejar vacio: usa Ethereal y deja el enlace de vista previa en el log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Proxi <no-responder@proxi.cl>"

# ---- Reglas de negocio (dias) ----
SLA_RESPUESTA_DIAS=15
PLAZO_DECLARAR_CIERRE_DIAS=7
RETENCION_CV_MESES=12
RETENCION_AVISO_DIAS=30
# Auditoria de accesos, en dos etapas (specs/11-retencion-de-auditoria): a los N meses se anulan la
# IP y el navegador (la fila sobrevive como evidencia de quien accedio a que y cuando); a los M
# meses se borra la fila. M no puede ser menor que N o la app no arranca.
# Cuanto se conserva una sesion ya vencida o revocada. Guarda ip y user_agent, el mismo dato de red
# que la auditoria; 90 dias alcanza para investigar un incidente reciente.
RETENCION_SESIONES_DIAS=90
RETENCION_AUDITORIA_MESES=12
RETENCION_AUDITORIA_BORRADO_MESES=24
